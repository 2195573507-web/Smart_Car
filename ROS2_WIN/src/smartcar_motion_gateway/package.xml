<?xml version="1.0"?>
<package format="3">
  <name>smartcar_motion_gateway</name>
  <version>0.1.0</version>
  <description>Gated Nav2 velocity gateway for the Smart Car S3 control link.</description>
  <maintainer email="smart-car@example.invalid">Smart Car project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>smartcar_state_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
